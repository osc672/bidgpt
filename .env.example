# ---------------------------------------------------------------------------
# BidGPT configuration
# ---------------------------------------------------------------------------

# Where registry.sqlite and per-site indexes live.
BIDGPT_DATA_DIR=./data

# Crawl limits
CRAWL_DEPTH=2
MAX_PAGES=100
RECRAWL_INTERVAL_SECONDS=21600
REQUEST_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=8000000
MAX_PDF_BYTES=15000000
USER_AGENT=BidGPTBot/1.0 (+https://your-domain.example/bot)

# Playwright is used only when a page looks JavaScript-rendered. Set false to
# use the httpx + BeautifulSoup path everywhere.
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_WAIT_MS=750

# Optional: custom Playwright browser directory. Useful when the system drive
# is small, e.g. PLAYWRIGHT_BROWSERS_PATH=D:\bidgpt\.playwright on Windows.
# Install with the same variable set:
#   python -m playwright install chromium
# PLAYWRIGHT_BROWSERS_PATH=

# Allow crawling loopback/private IPs. Keep false in production (SSRF guard).
ALLOW_PRIVATE_URLS=false

# Crawl backend: auto | local | firecrawl.
#   auto      use Firecrawl when FIRECRAWL_API_KEY is set, else the built-in
#             httpx + Playwright crawler
#   local     always use the built-in crawler
#   firecrawl require Firecrawl
# Firecrawl is only used at crawl time; questions are still answered from the
# per-site index. Private/loopback targets always use the local crawler.
CRAWLER_BACKEND=auto
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# Maximum time to wait for one crawl job, and how often to poll it.
FIRECRAWL_TIMEOUT_SECONDS=300
FIRECRAWL_POLL_SECONDS=2

# LLM (OpenAI-compatible or Anthropic). Leave the key empty to run in grounded
# deterministic mode (no network calls, answers built from search results).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Rate limiting for /chat
CHAT_RATE_LIMIT_PER_IP=20
CHAT_RATE_LIMIT_PER_SITE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional admin protection for POST /sites and /sites/{key}/recrawl
ADMIN_API_KEY=

# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false

# Extra origins allowed to call the widget API (comma separated), e.g. the
# local demo page. The registered domain is always allowed.
WIDGET_EXTRA_ORIGINS=
